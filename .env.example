# ==========================================
# Configuración de Twitch API e IRC
# ==========================================
# Registrar una app en la Consola de Desarrolladores de Twitch:
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# IDs numéricos de usuario en Twitch (puedes consultarlos vía API o twitchinsights.net/id)
# BOT_ID: ID de la cuenta de Twitch que actuará como bot
BOT_ID=your_bot_user_id_here
# OWNER_ID: Tu ID numérico de usuario en Twitch (propietario del bot)
OWNER_ID=your_owner_user_id_here

# Token OAuth de chat para conexión IRC (debe incluir el prefijo 'oauth:')
# Generar en: https://twitchapps.com/tmi/ o mediante Twitch CLI
IRC_TOKEN=oauth:your_irc_oauth_token_here


# ==========================================
# Google Gemini AI Key
# ==========================================
# Obtener tu API Key en Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here


# Modelo de Gemini a utilizar (opcional, por defecto: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite


# ==========================================
# Base de Datos PostgreSQL (Prisma Cloud / Supabase / Neon / Local)
# ==========================================
# URL de conexión agrupada (Connection Pooling) para la aplicación
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# URL de conexión directa al servidor PostgreSQL para migraciones de Prisma
DIRECT_URL="postgres://user:password@host:5432/dbname?sslmode=require"

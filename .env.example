# ==========================================
# Configuración de Twitch API e IRC
# ==========================================
# Registrar una app en la Consola de Desarrolladores de Twitch:
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# IDs numéricos de usuario en Twitch (puedes consultarlos vía API con extra/get_twitch_ids.py)
# BOT_ID: ID de la cuenta de Twitch que actuará como bot
BOT_ID=your_bot_user_id_here
# OWNER_ID: Tu ID numérico de usuario en Twitch (propietario del canal)
OWNER_ID=your_owner_user_id_here

# Token OAuth de chat para conexión IRC (debe incluir el prefijo 'oauth:')
# Generar en: https://twitchtokengenerator.com/ o mediante Twitch CLI
IRC_TOKEN=oauth:your_irc_oauth_token_here


# ==========================================
# Google Gemini AI Key
# ==========================================
# Obtener tu API Key en Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a utilizar (opcional, por defecto: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite


# ==========================================
# Base de Datos PostgreSQL (Prisma Console / Prisma Postgres)
# ==========================================
# URL de conexión de tu base de datos en Prisma Console
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# URL de conexión directa al servidor PostgreSQL para migraciones y pool asyncpg
DIRECT_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Clave Fernet (32 bytes en base64 urlsafe) para cifrado primario de tokens OAuth en la DB.
# Opcional: si no se define, se deriva automáticamente de TWITCH_CLIENT_SECRET vía HKDF
# (con soporte MultiFernet para descifrar y rotar tokens generados con esquemas previos).
# Para generar una clave nueva: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# ==========================================
# Entorno de Ejecución (development | production) y Servidor Web
# ==========================================
# development: Uso local / LAN (carga certs/*-key.pem y certs/*.pem si existen para PWA local,
#              habilita puerto Vite 5173 para CSWSH, límite de 20 WS, sin auto-apagado)
# production:  Uso en servidor remoto / proxy (HSTS, max 3 WS, auto-apagado idle tras 300s)
APP_ENV=development

# Host y puerto de escucha del servidor web Starlette / Uvicorn (alias soportados: HOST y PORT)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Límites de conexiones WebSocket e inactividad (valores por defecto según APP_ENV):
# - En development: MAX_WS_CLIENTS=20, IDLE_SHUTDOWN_SECONDS=0 (desactivado)
# - En production:  MAX_WS_CLIENTS=3,  IDLE_SHUTDOWN_SECONDS=300 (5 minutos)
# MAX_WS_CLIENTS=20
# IDLE_SHUTDOWN_SECONDS=0

# Token opcional de autenticación para el Dashboard Web y la API REST.
# Si se define, el acceso web exige ?token=VALOR (establece cookie HttpOnly y redirige limpia la URL)
# o la cabecera 'Authorization: Bearer VALOR' / 'X-Access-Token: VALOR'.
# Endpoints públicos exentos: /api/health y assets mínimos para instalación PWA (manifest, sw, icons).
# WEB_ACCESS_TOKEN=

# Orígenes CORS y CSWSH adicionales permitidos separados por coma (ej. proxy Tailscale o dominio público):
# CORS_ORIGINS=https://bot-tv.tu-tailnet.ts.net

# Direcciones IP confiables para cabeceras de proxy inverso (X-Forwarded-For, X-Forwarded-Proto) en Uvicorn.
# Por defecto: 127.0.0.1,::1. Si estás detrás de Nginx, Caddy, Cloudflare o un proxy inverso, configúralo aquí.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ==========================================
# Configuración de Twitch API e IRC
# ==========================================
# Registrar una app en la Consola de Desarrolladores de Twitch:
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# IDs numéricos de usuario en Twitch (puedes consultarlos vía API o twitchinsights.net/id)
# BOT_ID: ID de la cuenta de Twitch que actuará como bot
BOT_ID=your_bot_user_id_here
# OWNER_ID: Tu ID numérico de usuario en Twitch (propietario del bot)
OWNER_ID=your_owner_user_id_here

# Token OAuth de chat para conexión IRC (debe incluir el prefijo 'oauth:')
# Generar en: https://twitchtokengenerator.com/ o mediante Twitch CLI
IRC_TOKEN=oauth:your_irc_oauth_token_here


# ==========================================
# Google Gemini AI Key
# ==========================================
# Obtener tu API Key en Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here


# Modelo de Gemini a utilizar (opcional, por defecto: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite


# ==========================================
# Base de Datos PostgreSQL (Prisma Console / Prisma Postgres)
# ==========================================
# URL de conexión de tu base de datos en Prisma Console
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# URL de conexión directa al servidor PostgreSQL para migraciones y asyncpg
DIRECT_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Clave maestra Fernet para cifrado simétrico de tokens OAuth en la base de datos
# (Si no se define al ejecutar `uv run bot-setup`, se generará automáticamente)
ENCRYPTION_KEY=your_fernet_encryption_key_here


# ==========================================
# Entorno de Ejecución (development | production) y Servidor Web
# ==========================================
# development: Uso en PC local/LAN (habilita certs/*.pem, live-reload, sin auto-apagado)
# production:  Uso en Nube/Tailscale (HSTS, caché estática, max 3 WS, auto-apagado idle)
APP_ENV=development

# Host y puerto de escucha
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Límites opcionales (por defecto en dev: 20 clientes y 0s idle; en prod: 3 clientes y 300s idle)
# MAX_WS_CLIENTS=3
# IDLE_SHUTDOWN_SECONDS=300

# Token opcional de seguridad adicional (?token=...) y orígenes extra (ej. Tailscale)
# WEB_ACCESS_TOKEN=
# CORS_ORIGINS=https://bot-tv.tu-tailnet.ts.net



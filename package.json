{
  "name": "bot-tv",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint src/bot_tv/web/static && eslint src/bot_tv/web/static",
    "lint:fix": "oxlint --fix src/bot_tv/web/static && eslint --fix src/bot_tv/web/static",
    "format": "prettier --write \"src/bot_tv/web/static/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/bot_tv/web/static/**/*.{js,html,css}\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:status": "prisma migrate status",
    "release": "release-it"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "eslint": "10.5.0",
    "oxlint": "1.71.0",
    "prettier": "3.8.4",
    "prisma": "7.8.0",
    "release-it": "18.0.0",
    "tsx": "4.23.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "pg": "8.22.0"
  }
}

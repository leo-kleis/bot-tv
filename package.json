{
  "name": "bot-tv",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint src/bot_tv/web/static && eslint src/bot_tv/web/static",
    "lint:fix": "oxlint --fix src/bot_tv/web/static && eslint --fix src/bot_tv/web/static",
    "format": "prettier --write \"src/bot_tv/web/static/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/bot_tv/web/static/**/*.{js,html,css}\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:status": "prisma migrate status",
    "release": "release-it --only-version"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "release-it": "21.0.0",
    "tsx": "4.23.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "pg": "8.22.0"
  }
}

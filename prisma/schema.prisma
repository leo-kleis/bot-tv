datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  user_id           String        @id @map("user_id")
  username          String        @map("username")
  display_name      String?       @map("display_name")
  nickname          String?       @map("nickname")
  is_bot            Boolean       @default(false) @map("is_bot")
  profile_image_url String?       @map("profile_image_url")
  chat_history      ChatHistory[]
  channel_users     ChannelUser[]

  @@index([username], map: "idx_users_username")
  @@map("users")
}

model ChatHistory {
  id         String   @id @db.Uuid @map("id")
  channel_id String   @map("channel_id")
  user_id    String   @map("user_id")
  message    String   @map("message")
  timestamp  DateTime @default(now()) @db.Timestamptz @map("timestamp")
  stream_id  String?  @map("stream_id")

  user User @relation(fields: [user_id], references: [user_id])

  @@index([channel_id, user_id], map: "idx_chat_history_channel_user")
  @@index([channel_id, timestamp(sort: Desc)], map: "idx_chat_history_channel_ts")
  @@index([stream_id, timestamp], map: "idx_chat_history_stream_ts")
  @@map("chat_history")
}

model StreamSession {
  stream_id        String           @id @map("stream_id")
  channel_id       String           @map("channel_id")
  title            String?          @map("title")
  category_name    String?          @map("category_name")
  is_live          Boolean          @default(true) @map("is_live")
  started_at       DateTime         @db.Timestamptz @map("started_at")
  ended_at         DateTime?        @db.Timestamptz @map("ended_at")
  last_seen_at     DateTime         @default(now()) @db.Timestamptz @map("last_seen_at")
  peak_viewers     Int              @default(0) @map("peak_viewers")
  close_reason     String?          @map("close_reason")

  viewer_snapshots ViewerSnapshot[]
  stream_events    StreamEvent[]

  @@index([channel_id, started_at(sort: Desc)], map: "idx_stream_sessions_channel_started")
  @@map("stream_sessions")
}

model ViewerSnapshot {
  id           BigInt        @id @default(autoincrement()) @map("id")
  stream_id    String        @map("stream_id")
  channel_id   String        @map("channel_id")
  viewer_count Int           @map("viewer_count")
  recorded_at  DateTime      @default(now()) @db.Timestamptz @map("recorded_at")

  session      StreamSession @relation(fields: [stream_id], references: [stream_id], onDelete: Cascade)

  @@index([stream_id, recorded_at(sort: Desc)], map: "idx_viewer_snapshots_stream_ts")
  @@map("viewer_snapshots")
}

model StreamEvent {
  id          BigInt         @id @default(autoincrement()) @map("id")
  stream_id   String?        @map("stream_id")
  channel_id  String         @map("channel_id")
  event_type  String         @map("event_type")
  event_data  Json           @default("{}") @map("event_data")
  timestamp   DateTime       @default(now()) @db.Timestamptz @map("timestamp")

  session     StreamSession? @relation(fields: [stream_id], references: [stream_id], onDelete: SetNull)

  @@index([stream_id, timestamp(sort: Desc)], map: "idx_stream_events_stream_ts")
  @@index([stream_id, event_type], map: "idx_stream_events_stream_type")
  @@map("stream_events")
}


model ChannelUser {
  channel_id    String    @map("channel_id")
  user_id       String    @map("user_id")
  followed_at   DateTime? @db.Timestamptz @map("followed_at")
  unfollowed_at DateTime? @db.Timestamptz @map("unfollowed_at")

  // Roles específicos del canal
  is_moderator  Boolean @default(false) @map("is_moderator")
  is_vip        Boolean @default(false) @map("is_vip")
  is_subscriber Boolean @default(false) @map("is_subscriber")
  sub_tier      String? @map("sub_tier")   // "1000" | "2000" | "3000"
  gifter_id     String? @map("gifter_id")  // user_id de quien regaló la sub

  user User @relation(fields: [user_id], references: [user_id])

  @@id([channel_id, user_id])
  @@index([channel_id, followed_at(sort: Desc)], map: "idx_channel_users_followed")
  @@index([channel_id, unfollowed_at(sort: Desc)], map: "idx_channel_users_unfollowed")
  @@map("channel_users")
}

model AppSettings {
  key   String @id @map("key")
  value String @map("value")

  @@map("app_settings")
}

model ApiConsumptionLog {
  id        BigInt @id @default(autoincrement()) @map("id")
  model     String @map("model")
  timestamp Float  @map("timestamp")
  type      String @map("type")

  @@index([timestamp], map: "idx_api_consumption_ts")
  @@map("api_consumption_log")
}

model Token {
  user_id  String @id @map("user_id")
  username String @map("username")
  token    String @map("token")
  refresh  String @map("refresh")

  @@map("tokens")
}
